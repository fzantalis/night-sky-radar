#pragma once
// Copy this file to src/secrets.h and fill in your network.
// src/secrets.h is gitignored and must never be committed.
#define WIFI_SSID "your-network"
#define WIFI_PASS "your-password"

// --- Optional: fixed address -------------------------------------------
//
// Leave these commented out to use DHCP, which is the right default.
//
// Define all four to pin the device to one address. Worth doing when the
// router will not hand out a lease (a client can associate perfectly and still
// never get one), or simply to stop the address moving, which turns "open the
// web view" into a subnet scan.
//
// If a fixed address fails to connect within 20 seconds the firmware falls
// back to DHCP on its own, so carrying the instrument to another network still
// works.
//
// #define STATIC_IP      "192.168.1.77"
// #define STATIC_GATEWAY "192.168.1.1"
// #define STATIC_SUBNET  "255.255.255.0"
// #define STATIC_DNS     "192.168.1.1"
